# 环境模板：新环境照抄成对应文件再填真值
#   cp .env.example .env.local   # 本机原生开发（uv run dev）
#
# APP_ENV 决定读哪个 env 文件：local=.env.local / test=.env.test
# docker、prod 不读文件，连接串由 compose 的 environment 注入（容器内服务名 + 固定 5432）

APP_ENV=local

# 宿主机映射端口：只给 docker compose 的 ports 用；
# app 的连接串里永远写 localhost:${POSTGRES_PORT}，容器内则写 postgres:5432
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://smartdocs:smartdocs@localhost:5433/smartdocsdb
REDIS_URL=redis://localhost:6379/0
ARQ_REDIS_URL=redis://localhost:6379/1

# 生成：python -c "import os; print(os.urandom(32).hex())"
JWT_SECRET_KEY=change-me
EMBEDDING_API_KEY=change-me

DEBUG=true
RATE_LIMIT_ENABLED=true
